# 复制为 .env（不要提交）。一键部署脚本会自动生成此文件。
# 留空 WEB_PASSWORD 时，首次打开网页会要求设置账号和密码。
WEB_PASSWORD=
SETUP_TOKEN=
WEB_USERNAME=
NAPCAT_ACCESS_TOKEN=
# 通过 HTTPS 域名访问时填写，例如 https://chat.example.com；留空按请求 Host 校验。
PUBLIC_BASE_URL=
# 可选：有权使用 = CLEAR 和 = REBOOT 的 QQ 号。
ADMIN_QQ_ID=
# 只填实际反代地址/CIDR；反代必须覆盖 X-Forwarded-Proto 和转发链。
TRUSTED_PROXIES=
# Python直启数据目录；Compose中固定为/data。不要提交运行数据。
CHAT_DATA_DIR=
# 默认向QQ消息正文附加访问者IP与时间；如需关闭设false。
DISCLOSE_CLIENT_IP=true
# 一键脚本使用：容器端口和监听地址。
WEBCHAT_PORT=4001
WEBCHAT_BIND=127.0.0.1
