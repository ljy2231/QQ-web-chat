# 将此文件复制为 .env 并填写自己的值；不要提交 .env。
WEB_PASSWORD=
NAPCAT_ACCESS_TOKEN=
PUBLIC_BASE_URL=
# 可选：有权使用 = ALL ON/OFF、= CLEAR 和 = REBOOT 的 QQ 号。
ADMIN_QQ_ID=
# 只填实际反代地址/CIDR；反代必须覆盖 X-Forwarded-Proto 和转发链。
TRUSTED_PROXIES=
# Python直启数据目录；Compose中固定为/data。不要提交运行数据。
CHAT_DATA_DIR=
# 默认向QQ消息正文附加访问者IP与时间；如需关闭设false。
DISCLOSE_CLIENT_IP=true
